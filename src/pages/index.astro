---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/public/SiteHeader.astro';
import Hero from '../components/public/Hero.astro';
import FeatureGrid from '../components/public/FeatureGrid.astro';
import Footer from '../components/public/Footer.astro';

type PublicSettings = {
  site?: { title?: string; logo?: string; footer?: string };
  seo?: { default_description?: string };
};

type ResolvedSettings = {
  site: { title: string; logo: string; footer: string };
  seo: { default_description: string };
};

const fallbackSettings: ResolvedSettings = {
  site: {
    title: 'Cloudflare Native Wiki',
    logo: '',
    footer: '© Cloudflare Native Wiki · Built with Astro + Cloudflare Pages'
  },
  seo: {
    default_description: '一个 Cloudflare Native Markdown Wiki，面向 Emby 与媒体服务教程。'
  }
};

let publicSettings: ResolvedSettings = fallbackSettings;

try {
  const res = await fetch(new URL('/api/settings/public', Astro.url));
  if (res.ok) {
    const data = (await res.json()) as PublicSettings;
    publicSettings = {
      site: {
        title: data.site?.title || fallbackSettings.site.title,
        logo: data.site?.logo || fallbackSettings.site.logo,
        footer: data.site?.footer || fallbackSettings.site.footer
      },
      seo: {
        default_description: data.seo?.default_description || fallbackSettings.seo.default_description
      }
    };
  }
} catch {
  publicSettings = fallbackSettings;
}

const siteTitle = publicSettings.site.title ?? fallbackSettings.site.title;
const siteLogo = publicSettings.site.logo ?? fallbackSettings.site.logo;
const siteFooter = publicSettings.site.footer ?? fallbackSettings.site.footer;
const siteDescription = publicSettings.seo.default_description ?? fallbackSettings.seo.default_description;

const suggestedDocs = [
  { title: '快速开始', href: '/docs/getting-started', desc: '了解站点结构、编辑与发布流程。' },
  { title: '旧链接重定向示例', href: '/docs/getting-started-old', desc: '验证历史 slug 自动重定向能力。' },
  { title: '后台管理入口', href: '/admin/login', desc: '登录后可管理页面、导航、资源与设置。' }
];
---
<BaseLayout title={siteTitle} description={siteDescription}>
  <div class="page-shell">
    <SiteHeader siteTitle={siteTitle} siteLogo={siteLogo} />
    <main>
      <Hero siteTitle={siteTitle} description={siteDescription} />
      <FeatureGrid />

      <section class="container section">
        <div class="section-head">
          <h2>推荐阅读</h2>
        </div>
        <div class="doc-list">
          {suggestedDocs.map((doc) => (
            <a class="doc-item" href={doc.href}>
              <h3>{doc.title}</h3>
              <p>{doc.desc}</p>
            </a>
          ))}
        </div>
      </section>
    </main>
    <Footer footerText={siteFooter} />
  </div>
</BaseLayout>
