---
export interface Props {
  siteTitle: string;
  siteLogo?: string;
}
const { siteTitle, siteLogo } = Astro.props;
---
<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="brand">
      {siteLogo ? <img src={siteLogo} alt={siteTitle} class="brand-logo" /> : <span class="brand-dot" aria-hidden="true"></span>}
      <span class="brand-name">{siteTitle}</span>
    </a>

    <div class="header-search">
      <input type="search" placeholder="搜索文档（即将支持）" aria-label="搜索文档" />
    </div>

    <nav class="header-nav">
      <a href="/docs/getting-started" class="btn btn-primary">开始阅读</a>
      <a href="/admin" class="btn btn-ghost">后台管理</a>
    </nav>
  </div>
</header>
