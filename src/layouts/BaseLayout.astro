---
import '../styles/global.css';

const {
  title = 'Emby Wiki',
  description = 'Cloudflare Native Emby Wiki',
  lang = 'zh-CN'
} = Astro.props;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
